<?xml version="1.0"?>
<robot name="hier_case_study">
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
    <collision><geometry><box size="0.4 0.3 0.1"/></geometry></collision>
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
  </link>

  <link name="left_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0025"/>
    </inertial>
    <collision><geometry><cylinder length="0.04" radius="0.10"/></geometry></collision>
    <visual>
      <geometry><cylinder length="0.04" radius="0.10"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>

  <link name="right_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0025"/>
    </inertial>
    <collision><geometry><cylinder length="0.04" radius="0.10"/></geometry></collision>
    <visual>
      <geometry><cylinder length="0.04" radius="0.10"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>

  <link name="caster">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision><geometry><sphere radius="0.02"/></geometry></collision>
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.17 -0.05" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.17 -0.05" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.17 0.0 -0.08"/>
  </joint>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="caster">
    <mu1>0.0</mu1><mu2>0.0</mu2><kp>1000000.0</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/mamingyuan/Desktop/ros2_control-humble/case_study/logs/run_50hz_single-pass/controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <ros2_control name="DiffDriveSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
